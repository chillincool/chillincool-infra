{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>home-operations/renovate-presets#9.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#9.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#9.0.0",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Chicago)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  packageRules: [
    {
      description: "MyAnonamouse only allows qBittorrent 5.2.x",
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      allowedVersions: "<5.3.0",
    },
    // Auto-merge. home-operations/renovate-presets ships no automerge rules, so without
    // these every update waits for a manual merge. Renovate merges as a PR once its checks
    // (flux-local) pass; platformAutomerge is off so it never merges ahead of those checks.
    // rebaseWhen "conflicted": otherwise automerge forces every PR to be retested after
    // each merge, and only one PR gets merged per hourly run.
    {
      description: "Auto-merge container and chart digests (same version, rebuilt)",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      rebaseWhen: "conflicted",
    },
    {
      description: "Auto-merge patch updates once they've been out three days",
      matchUpdateTypes: ["patch"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      rebaseWhen: "conflicted",
    },
    {
      description: "Auto-merge GitHub Actions and mise tool updates; CI-only, can't touch the cluster",
      matchManagers: ["github-actions", "mise"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: false,
      rebaseWhen: "conflicted",
    },
    {
      description: "Never auto-merge core infrastructure; on one node a bad update takes everything down",
      matchPackageNames: [
        "/cilium/",
        "/siderolabs/",
        "/talos/",
        "/kube-apiserver|kube-controller-manager|kube-scheduler|kubelet|kube-proxy/",
        "/kubectl/",
        "/fluxcd|flux-operator|flux-instance|flux2/",
        "/longhorn/",
        "/cloudnative-pg|cnpg/",
        "/keycloak/",
        "/envoyproxy|gateway-helm|gateway-api/",
        "/cert-manager|jetstack/",
        "/external-secrets/",
        "/1password/",
        "/coredns/",
      ],
      automerge: false,
    },
  ],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/resources/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}
